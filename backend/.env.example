# FixNearby Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
PORT=5000

# Security Secrets (Replace with secure random strings in production)
SECRET_KEY=fixnearby-super-secret-key-production-safety-2026
JWT_SECRET_KEY=fixnearby-jwt-secret-key-kolhapur-emergency-2026
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database Configuration (PostgreSQL with PostGIS)
# Default connection string for PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fixnearby
# Fallback SQLite URI for dev environments without local PostgreSQL
# SQLITE_URL=sqlite:///fixnearby_dev.db

# CORS Origin
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# OSRM Public Routing Base URL
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving

# Rate Limiter Memory Storage URI
RATE_LIMIT_STORAGE_URI=memory://

